<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ARTVpn.Service</AssemblyName>
    <RootNamespace>ArtSport.ArtVpn.Service</RootNamespace>
    <Version>0.1.0</Version>
    <Company>ARTSPORT</Company>
    <Product>ART VPN</Product>
    <Title>Служба ART VPN</Title>
    <Description>Фоновая служба ART VPN</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- Keep old generated files out when build intermediates are placed on D:. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\common\UpdateJson.cs" Link="Common\UpdateJson.cs" />
    <Compile Include="..\..\integration\MicrosoftAuthProxyCompatibility.cs" Link="Shared\MicrosoftAuthProxyCompatibility.cs" />
    <Compile Include="..\common\ExternalProxyEndpoint.cs" Link="Common\ExternalProxyEndpoint.cs" />
    <Compile Include="..\common\ConnectionProblemText.cs" Link="Common\ConnectionProblemText.cs" />
    <Compile Include="..\common\SystemProxyLease.cs" Link="Common\SystemProxyLease.cs" />
    <Compile Include="..\common\AcceptedClientRelease.cs" Link="Common\AcceptedClientRelease.cs" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
