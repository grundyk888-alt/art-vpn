<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ARTVpn.UI</AssemblyName>
    <RootNamespace>ArtSport.ArtVpn.Ui</RootNamespace>
    <Version>0.1.0</Version>
    <Company>ARTSPORT</Company>
    <Product>ART VPN</Product>
    <Title>ART VPN</Title>
    <Description>ART VPN для ChatGPT, YouTube и других сервисов</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>..\..\ui\Assets\art-monitor.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\common\UpdateJson.cs" Link="Common\UpdateJson.cs" />
    <Compile Include="..\service\SignedUpdatePolicy.cs" Link="Common\SignedUpdatePolicy.cs" />
    <Compile Include="..\common\ProviderConnectionClient.cs" Link="Common\ProviderConnectionClient.cs" />
    <Compile Include="..\..\integration\VpnMaintenanceLauncher.cs" Link="Shared\VpnMaintenanceLauncher.cs" />
    <Compile Include="..\common\ExternalProxyEndpoint.cs" Link="Common\ExternalProxyEndpoint.cs" />
    <Compile Include="..\common\ConnectionProblemText.cs" Link="Common\ConnectionProblemText.cs" />
    <Compile Include="..\common\AcceptedClientRelease.cs" Link="Common\AcceptedClientRelease.cs" />
    <Compile Include="..\common\QuattroRecommendation.cs" Link="Common\QuattroRecommendation.cs" />
    <Compile Include="..\..\integration\CodexProxyCompatibility.cs" Link="Shared\CodexProxyCompatibility.cs" />
    <Compile Include="..\..\integration\ControlReplyPolicy.cs" Link="Shared\ControlReplyPolicy.cs" />
    <EmbeddedResource Include="..\..\ui\Assets\art-monitor.ico"
                      Link="Assets\art-monitor.ico"
                      LogicalName="ARTVpn.UI.Assets.art-monitor.ico" />
    <Compile Remove="ChatGptUpdateHelper.cs" />
  </ItemGroup>
</Project>
